{
  "name": "agent-deathmatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kill time while your coding agent works. A robot arena shooter with automatic task completion handoff to Codex.",
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-native.mjs",
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "predev:lan": "node scripts/ensure-native.mjs && node scripts/lan-url.mjs",
    "dev:lan": "concurrently -k -n web,server -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "predev:server": "node scripts/ensure-native.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "lan": "node scripts/lan-url.mjs",
    "netcode:load": "tsx scripts/netcode-load.ts",
    "bots:sim": "tsx scripts/bot-sim.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "serve": "npm run build && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:security": "node --import tsx --test tests/security.test.ts",
    "test:arcade": "node --import tsx --test tests/arcade.test.ts tests/net-transport.test.ts tests/codex-integration.test.ts tests/codex-adapters.test.mjs tests/codex-setup.test.mjs tests/audio.test.ts tests/audio-player.test.mjs tests/shot-timing.test.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test:worker": "node --import tsx --test tests/cloudflare-worker.test.ts",
    "build:cloudflare": "npm run typecheck:worker && npm run test:worker && npm run build",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "0.184.0",
    "tsx": "^4.20.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.184.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
