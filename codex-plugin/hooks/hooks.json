{
  "description": "Observe Codex attention requests without changing approval or input behavior.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/notify.mjs\" --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input(_async)?$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/notify.mjs\" --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
